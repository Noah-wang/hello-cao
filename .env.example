# Reset the token that was previously exposed, then put the NEW token here.
DISCORD_BOT_TOKEN=

# OpenAI-compatible API settings.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1

# Describe only the speaking style. Do not add identity claims or private facts.
STYLE_DESCRIPTION=语气自然、简短、带一点冷幽默；先直接回答，再补充必要解释。

# One-time style extraction. Enable Discord Developer Mode to copy these IDs.
STYLE_CHANNEL_ID=
STYLE_TARGET_USER_ID=
STYLE_MAX_MESSAGES=3000
STYLE_SCAN_LIMIT=20000
STYLE_PROFILE_PATH=data/style-profile.json
STYLE_SOURCE_PATH=config/style-source.json
USER_TITLES_PATH=config/user-titles.json
SYSTEM_PROMPT_PATH=config/system-prompt.md
TOKEN_USAGE_PATH=data/token-usage.json

# Monid web search
MONID_API_KEY=
MONID_BASE_URL=https://api.monid.ai
